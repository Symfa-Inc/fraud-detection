# OpenAI API key (required for LLM-generated summaries)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model for summary generation (e.g. gpt-4o-mini, gpt-4o)
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Paths (relative to backend/ directory)
MODEL_DIR=models/neuralnet/
FEATURE_IMPORTANCE_PATH=data/feature_importance_shap.json
TRAIN_DATA_PATH=data/train.parquet
